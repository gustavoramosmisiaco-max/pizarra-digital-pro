{
  "name": "pizarra-digital-pro",
  "productName": "Pizarra Digital Pro",
  "private": true,
  "version": "1.0.0",
  "description": "Pizarra Digital Pro Interactiva para Docentes y Estudiantes con soporte Stylus",
  "author": "Nexoris Academy",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "dev:desktop": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on tcp:5173 && electron .\"",
    "build:desktop": "npm run build && electron-builder --dir",
    "build:exe": "npm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.nexoris.pizarrapro",
    "productName": "Pizarra Digital Pro",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "clsx": "^2.1.1",
    "fabric": "^5.3.0",
    "idb-keyval": "^6.2.1",
    "jspdf": "^2.5.1",
    "katex": "^0.18.7",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^9.1.0"
  }
}
